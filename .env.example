# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# Placeholders only. Restart `npm run dev` after changing values.

# Public address of the site (no trailing slash). Used in links sent to clients (login and invoice links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never share or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random text. Used to hash visitor IPs for enquiry rate limiting.
RATE_LIMIT_SALT=change-this-to-a-long-random-text

# --- Optional: WhatsApp Business Cloud API (admin alerts for new enquiries) ---
WHATSAPP_CLOUD_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Admin number that receives alerts, international format without +
WHATSAPP_ADMIN_NUMBER=8801778854463
# Name of an approved message template with one body variable
WHATSAPP_TEMPLATE_NAME=your-approved-template-name
